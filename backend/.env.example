# Copy to .env for local overrides. In production, set these as real
# environment variables on your host instead of committing a .env file.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False

# Comma-separated
ALLOWED_HOSTS=your-backend-domain.com,localhost,127.0.0.1
# Your Vercel frontend URL(s) go here (e.g. https://trust-gambit.vercel.app)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Postgres connection string. Omit entirely to fall back to local SQLite.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Optional: if all three are set, the server creates this admin account
# automatically on startup (see Procfile) — useful on hosts like Render's
# free tier where a Shell tab to run `createsuperuser` isn't available.
# Already-existing accounts are left untouched; safe to leave set permanently.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-to-something-strong

# Required for the registration email-verification link to actually send.
# Without these, emails just print to the server log instead of sending -
# fine for local dev, not for a real event. Easiest option: a Gmail account
# with an "app password" (myaccount.google.com/apppasswords, needs 2FA on).
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-character-app-password
DEFAULT_FROM_EMAIL=your-gmail-address@gmail.com

# Your deployed frontend's URL - used to build the verification link that
# gets emailed (e.g. https://trust-gambit.vercel.app).
FRONTEND_URL=https://your-app.vercel.app
